rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public can view / read media assets
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
