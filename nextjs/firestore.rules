rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for website content, authenticated write for admins
    match /pages/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /blogs/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /team/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /media/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mediaFolders/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Admins and activity - authenticated users can read/write
    match /admins/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /activity/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default catch-all for any other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
